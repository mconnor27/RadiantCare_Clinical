<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every 5 minutes: forward the live schedule exports from OneDrive.
    Complete/ScheduleUpcoming.csv   -> R2 (Clinical dashboard)
    (Physician Schedule.csv is uploaded by the flow itself, not here)
  Uploads only when a file changed and passes validation.
  See scripts/sync_schedules.py.

  Install:
    cp scripts/com.radiantcare.schedule-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.radiantcare.schedule-sync.plist

  Run now:    launchctl start com.radiantcare.schedule-sync
  Logs:       tail -f /tmp/radiantcare_schedule_sync.log
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.radiantcare.schedule-sync.plist
    rm ~/Library/LaunchAgents/com.radiantcare.schedule-sync.plist

  Requires in project .env: R2_* credentials and ARIA_UPLOAD_API_KEY.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.radiantcare.schedule-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd /Users/Mike/RadiantCare_Clinical &amp;&amp; /Users/Mike/RadiantCare_Clinical/.venv/bin/python scripts/sync_schedules.py</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/radiantcare_schedule_sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/radiantcare_schedule_sync.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
