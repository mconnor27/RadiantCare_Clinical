<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nightly job: sanitize OneDrive → upload to Supabase Storage.

  Install:
    cp scripts/com.radiantcare.sanitize.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.radiantcare.sanitize.plist

  Verify it loaded:
    launchctl list | grep radiantcare

  Trigger immediately (don't wait for 4 AM):
    launchctl start com.radiantcare.sanitize

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.radiantcare.sanitize.plist
    rm ~/Library/LaunchAgents/com.radiantcare.sanitize.plist

  Requires in project .env: PHI_SALT, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.radiantcare.sanitize</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd /Users/Mike/RadiantCare_Clinical &amp;&amp; /Users/Mike/RadiantCare_Clinical/.venv/bin/python scripts/sanitize.py --upload</string>
  </array>

  <!-- Run daily at 4:00 AM (after ARIA's overnight exports land), plus
       catch-up fires at noon and 6pm so a laptop that was closed at 4am
       still gets a sanitized refresh later in the day. launchd coalesces
       missed StartCalendarInterval events on wake, so the first wake
       after 4am also triggers a run. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <!-- Also run once when the agent is (re)loaded, e.g., after login. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Logs — tail these to debug: tail -f /tmp/radiantcare_sanitize.log -->
  <key>StandardOutPath</key>
  <string>/tmp/radiantcare_sanitize.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/radiantcare_sanitize.err.log</string>

  <!-- Ensure PATH includes homebrew / system bins for openssl etc. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
